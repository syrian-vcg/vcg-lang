<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="20dp">

    <TextView android:id="@+id/label_github_user"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="?attr/colorTextMuted" android:textSize="13sp"
        android:layout_marginBottom="10dp"
        android:text="متّصل كـ: —"/>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="اسم المستودع الجديد (Repository)"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/input_repo_name"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:inputType="text"
            android:imeOptions="actionDone"/>
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="?attr/colorTextMuted" android:textSize="12sp"
        android:text="سيتم إنشاء مستودع خاص (Private) جديد ورفع كل ملفات المشروع إليه."/>
</LinearLayout>
