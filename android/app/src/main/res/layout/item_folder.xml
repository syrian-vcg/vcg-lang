<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginHorizontal="6dp"
    android:layout_marginVertical="4dp"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="?attr/selectableItemBackground"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp">

        <!-- Folder icon badge: amber/gold gradient chip -->
        <FrameLayout
            android:layout_width="44dp" android:layout_height="44dp"
            android:background="@drawable/bg_folder_icon">
            <ImageView
                android:layout_width="22dp" android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_folder"
                app:tint="?attr/colorGold"
                android:contentDescription="Folder"/>
        </FrameLayout>

        <!-- Folder info -->
        <LinearLayout
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp">

            <TextView android:id="@+id/folder_name"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="?attr/colorTextPrimary"
                android:textSize="14.5sp"
                android:textStyle="bold"
                android:fontFamily="monospace"/>

            <TextView android:id="@+id/folder_count"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="?attr/colorTextMuted"
                android:textSize="12sp"
                android:paddingTop="2dp"/>
        </LinearLayout>

        <ImageView
            android:layout_width="20dp" android:layout_height="20dp"
            android:src="@drawable/ic_topbar_back"
            android:rotation="180"
            app:tint="?attr/colorTextMuted"
            android:layout_marginEnd="6dp"
            android:contentDescription="Open"/>

        <!-- More (rename / delete) -->
        <ImageButton android:id="@+id/btn_delete"
            android:layout_width="38dp" android:layout_height="38dp"
            android:src="@android:drawable/ic_menu_delete"
            android:background="@drawable/bg_topbar_circle_btn"
            android:tint="?attr/colorTextMuted"
            android:contentDescription="Delete"/>
    </LinearLayout>

    <!-- Left accent stripe -->
    <View
        android:layout_width="3dp" android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="?attr/colorGold"/>

</androidx.cardview.widget.CardView>
