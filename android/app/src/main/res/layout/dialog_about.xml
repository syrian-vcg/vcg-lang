<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="?attr/colorBg">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="28dp">

        <!-- ═══════════ Header / Hero ═══════════ -->
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="?attr/colorSurface"
            android:paddingTop="26dp" android:paddingBottom="20dp"
            android:paddingHorizontal="24dp">

            <FrameLayout
                android:layout_width="74dp" android:layout_height="74dp"
                android:background="@drawable/bg_about_logo_badge">
                <ImageView
                    android:layout_width="44dp" android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_vcg_logo"
                    android:contentDescription="VCG"/>
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="محرر VCG السوري"
                android:textColor="?attr/colorTextPrimary"
                android:textSize="20sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Syrian VCG Editor"
                android:textColor="?attr/colorAccentSecondary"
                android:textSize="13sp"
                android:letterSpacing="0.04"/>

            <!-- Version chip + status chip -->
            <LinearLayout
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="14dp">

                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="الإصدار 2.1.0"
                    android:textColor="?attr/colorAccentPrimary"
                    android:textSize="12sp" android:textStyle="bold"
                    android:paddingHorizontal="12dp" android:paddingVertical="5dp"
                    android:background="@drawable/bg_about_chip_accent"
                    android:layout_marginEnd="8dp"/>

                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="مترجم C11 حقيقي"
                    android:textColor="?attr/colorGold"
                    android:textSize="12sp" android:textStyle="bold"
                    android:paddingHorizontal="12dp" android:paddingVertical="5dp"
                    android:background="@drawable/bg_about_chip_gold"/>
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent" android:layout_height="1.5dp"
            android:background="?attr/colorBorder"/>

        <!-- ═══════════ نبذة عن التطبيق ═══════════ -->
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="22dp" android:paddingTop="20dp">

            <TextView style="@style/AboutSectionTitle" android:text="📖  نبذة عن التطبيق"/>

            <TextView style="@style/AboutBody"
                android:text="VCG Editor هو محرر ومترجم متكامل لِلغة البرمجة السورية VCG، مصمَّم بالكامل ليعمل من هاتفك مباشرة دون الحاجة إلى حاسوب أو اتصال بالإنترنت. يقوم التطبيق بترجمة وتنفيذ الكود فعليًا عبر مترجم حقيقي مكتوب بلغة C11، وليس مجرد محاكاة أو واجهة شكلية."/>

            <TextView style="@style/AboutBody"
                android:layout_marginTop="8dp"
                android:text="يهدف المشروع إلى تقديم بيئة برمجة عربية بالكامل، من أسماء الأوامر إلى الرسائل وأدوات التحرير، لتكون لغة VCG قريبة من المبرمج العربي ومناسبة للتعليم والتجربة السريعة."/>
        </LinearLayout>

        <View style="@style/AboutDivider"/>

        <!-- ═══════════ المميزات ═══════════ -->
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="22dp" android:paddingTop="16dp">

            <TextView style="@style/AboutSectionTitle" android:text="✨  أبرز المميزات"/>
        </LinearLayout>

        <!-- Feature rows -->
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="22dp">

            <TextView style="@style/AboutFeatureRow"
                android:text="⚡  تنفيذ فوري للكود مع عرض النتائج في نافذة الإخراج"/>
            <TextView style="@style/AboutFeatureRow"
                android:text="📁  دعم كامل للمشاريع متعددة الملفات والوسائط"/>
            <TextView style="@style/AboutFeatureRow"
                android:text="🎨  أربعة سمات للواجهة: أبيض، غامق، أسود AMOLED، وأزرق"/>
            <TextView style="@style/AboutFeatureRow"
                android:text="🧩  محرر أكواد مزوَّد بتلوين الصيغة والإكمال الذكي"/>
            <TextView style="@style/AboutFeatureRow"
                android:text="🔗  رفع المشاريع مباشرة إلى GitHub من داخل التطبيق"/>
            <TextView style="@style/AboutFeatureRow"
                android:text="📦  استيراد وتصدير المشاريع بصيغة ZIP بضغطة واحدة"/>
            <TextView style="@style/AboutFeatureRow"
                android:text="💻  نافذة طرفية (Terminal) لتشغيل الأوامر المتقدمة"/>
            <TextView style="@style/AboutFeatureRow"
                android:text="🪙  نظام عملات داخلي وإعلانات اختيارية لدعم التطوير"/>
        </LinearLayout>

        <View style="@style/AboutDivider"/>

        <!-- ═══════════ دليل الاستخدام ═══════════ -->
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="22dp" android:paddingTop="16dp">

            <TextView style="@style/AboutSectionTitle" android:text="🧭  دليل استخدام التطبيق خطوة بخطوة"/>

            <TextView style="@style/AboutBody"
                android:layout_marginBottom="10dp"
                android:text="فيما يلي شرح مبسّط لكل ما تحتاجه للبدء بالبرمجة بلغة VCG، من إنشاء أول مشروع إلى تصديره ومشاركته."/>

            <!-- Step 1 -->
            <LinearLayout style="@style/AboutStepRow">
                <TextView style="@style/AboutStepNumber" android:text="1"/>
                <LinearLayout
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView style="@style/AboutStepTitle" android:text="إنشاء مشروع جديد"/>
                    <TextView style="@style/AboutStepBody"
                        android:text="اضغط على الزر الدائري (+) في الزاوية السفلية من الشاشة الرئيسية، ثم اكتب اسم المشروع وأكِّد الإنشاء. سيظهر مشروعك مباشرة في قائمة «مشاريعي»."/>
                </LinearLayout>
            </LinearLayout>

            <!-- Step 2 -->
            <LinearLayout style="@style/AboutStepRow">
                <TextView style="@style/AboutStepNumber" android:text="2"/>
                <LinearLayout
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView style="@style/AboutStepTitle" android:text="فتح المشروع وإضافة ملف"/>
                    <TextView style="@style/AboutStepBody"
                        android:text="اضغط على بطاقة المشروع لفتحه، ثم استخدم أيقونة الإضافة لإنشاء ملف كود جديد بامتداد VCG. يمكنك إضافة أكثر من ملف وتنظيمها داخل المشروع نفسه."/>
                </LinearLayout>
            </LinearLayout>

            <!-- Step 3 -->
            <LinearLayout style="@style/AboutStepRow">
                <TextView style="@style/AboutStepNumber" android:text="3"/>
                <LinearLayout
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView style="@style/AboutStepTitle" android:text="كتابة الكود"/>
                    <TextView style="@style/AboutStepBody"
                        android:text="افتح الملف داخل المحرر، حيث ستجد تلوين الصيغة وترقيم الأسطر يعملان تلقائيًا أثناء الكتابة. استخدم لوحة الأدوات السريعة فوق لوحة المفاتيح لإدراج الرموز والأقواس بسرعة."/>
                </LinearLayout>
            </LinearLayout>

            <!-- Step 4 -->
            <LinearLayout style="@style/AboutStepRow">
                <TextView style="@style/AboutStepNumber" android:text="4"/>
                <LinearLayout
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView style="@style/AboutStepTitle" android:text="تشغيل الكود ومشاهدة النتائج"/>
                    <TextView style="@style/AboutStepBody"
                        android:text="اضغط على زر التشغيل ▶ في شريط الأدوات العلوي لتنفيذ الكود فعليًا عبر المترجم. ستنتقل تلقائيًا إلى نافذة الإخراج لعرض المخرجات أو رسائل الأخطاء إن وُجدت."/>
                </LinearLayout>
            </LinearLayout>

            <!-- Step 5 -->
            <LinearLayout style="@style/AboutStepRow">
                <TextView style="@style/AboutStepNumber" android:text="5"/>
                <LinearLayout
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView style="@style/AboutStepTitle" android:text="إدارة الوسائط والملفات"/>
                    <TextView style="@style/AboutStepBody"
                        android:text="من قائمة المشروع يمكنك الدخول إلى «الوسائط» لإضافة صور أو ملفات يحتاجها برنامجك، وحذف أو إعادة تسمية أي ملف بسهولة من القائمة الجانبية."/>
                </LinearLayout>
            </LinearLayout>

            <!-- Step 6 -->
            <LinearLayout style="@style/AboutStepRow">
                <TextView style="@style/AboutStepNumber" android:text="6"/>
                <LinearLayout
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView style="@style/AboutStepTitle" android:text="استخدام نافذة الطرفية (Terminal)"/>
                    <TextView style="@style/AboutStepBody"
                        android:text="للمستخدمين المتقدمين، تتيح نافذة الطرفية تنفيذ أوامر المترجم مباشرة والتحكم الكامل بخيارات التشغيل والتصحيح."/>
                </LinearLayout>
            </LinearLayout>

            <!-- Step 7 -->
            <LinearLayout style="@style/AboutStepRow">
                <TextView style="@style/AboutStepNumber" android:text="7"/>
                <LinearLayout
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView style="@style/AboutStepTitle" android:text="تصدير المشروع أو رفعه إلى GitHub"/>
                    <TextView style="@style/AboutStepBody"
                        android:text="من قائمة (⋮) اختر «تصدير» للحصول على نسخة ZIP من مشروعك، أو «رفع إلى GitHub» لمشاركته مباشرة مع مستودعك الخاص بعد ربط حسابك."/>
                </LinearLayout>
            </LinearLayout>

            <!-- Step 8 -->
            <LinearLayout style="@style/AboutStepRow">
                <TextView style="@style/AboutStepNumber" android:text="8"/>
                <LinearLayout
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView style="@style/AboutStepTitle" android:text="استيراد مشروع جاهز"/>
                    <TextView style="@style/AboutStepBody"
                        android:text="من القائمة الرئيسية اختر «استيراد مشروع» لتحميل ملف ZIP من جهازك، وسيُضاف تلقائيًا إلى قائمة مشاريعك جاهزًا للتعديل والتشغيل."/>
                </LinearLayout>
            </LinearLayout>

            <!-- Step 9 -->
            <LinearLayout style="@style/AboutStepRow">
                <TextView style="@style/AboutStepNumber" android:text="9"/>
                <LinearLayout
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView style="@style/AboutStepTitle" android:text="تخصيص الواجهة"/>
                    <TextView style="@style/AboutStepBody"
                        android:text="توجّه إلى «الإعدادات ⚙» لتغيير سمة التطبيق بين الأبيض والغامق والأسود والأزرق، وضبط حجم الخط في المحرر بما يناسب راحة عينيك."/>
                </LinearLayout>
            </LinearLayout>

            <!-- Step 10 -->
            <LinearLayout style="@style/AboutStepRow">
                <TextView style="@style/AboutStepNumber" android:text="10"/>
                <LinearLayout
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <TextView style="@style/AboutStepTitle" android:text="كسب العملات وإرسال الاقتراحات"/>
                    <TextView style="@style/AboutStepBody"
                        android:text="اضغط «📺 اكسب عملات» لمشاهدة إعلان قصير ومكافأتك برصيد داعم للتطبيق، أو استخدم خيار «اقتراح جديد 💡» من القائمة لإرسال ملاحظاتك مباشرة إلى فريق التطوير."/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <View style="@style/AboutDivider"/>

        <!-- ═══════════ تواصل ومصدر ═══════════ -->
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="22dp" android:paddingTop="16dp">

            <TextView style="@style/AboutSectionTitle" android:text="🔗  المصدر والتواصل"/>

            <TextView style="@style/AboutBody"
                android:text="المشروع مفتوح المصدر بالكامل، ونرحّب بمساهماتكم وملاحظاتكم على المستودع الرسمي:"/>

            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="github.com/syrian-vcg/vcg-lang"
                android:textColor="?attr/colorInfoText"
                android:textSize="13.5sp" android:textStyle="bold"/>
        </LinearLayout>

        <!-- ═══════════ Footer ═══════════ -->
        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:paddingHorizontal="22dp"
            android:text="صُنع بـ ❤ من أجل مجتمع المبرمجين السوريين"
            android:textColor="?attr/colorTextMuted"
            android:textSize="12sp"
            android:textAlignment="center"/>

    </LinearLayout>
</ScrollView>
