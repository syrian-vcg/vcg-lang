<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#000000">

    <!--
        شاشة البداية الجديدة — الأيقونة الرسمية لـ VCG (chevrons + نص VCG)
        الانيميشن:
          1. الأيقونة تكبر من الأسفل مع fade-in (bounce خفيف)
          2. توهّج أخضر ينبض خلف الأيقونة
          3. بريق يعبر الأيقونة
          4. العنوان والوصف يصعدان للظهور
          5. نقاط تحميل تتموّج
    -->

    <!-- توهّج أخضر خلف الأيقونة -->
    <ImageView android:id="@+id/splash_glow"
        android:layout_width="260dp" android:layout_height="260dp"
        android:layout_gravity="center"
        android:layout_marginBottom="100dp"
        android:src="@drawable/bg_splash_glow"
        android:alpha="0"
        android:contentDescription="@null"/>

    <LinearLayout
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical" android:gravity="center">

        <!-- حاوية الأيقونة مع overlay البريق -->
        <FrameLayout
            android:layout_width="200dp" android:layout_height="200dp"
            android:layout_gravity="center">

            <!-- الأيقونة الرئيسية — الصورة الجديدة (chevrons + VCG) -->
            <ImageView android:id="@+id/splash_logo"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:src="@drawable/ic_vcg_splash_logo"
                android:scaleType="fitCenter"
                android:alpha="0"
                android:contentDescription="VCG Logo"/>

            <!-- شريط البريق فوق الأيقونة -->
            <ImageView android:id="@+id/layer_shine"
                android:layout_width="60dp" android:layout_height="280dp"
                android:layout_gravity="center"
                android:src="@drawable/bg_splash_shine"
                android:rotation="22"
                android:alpha="0"
                android:contentDescription="@null"/>

        </FrameLayout>

        <TextView android:id="@+id/splash_title"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Syrian VCG Editor"
            android:textSize="26sp" android:textStyle="bold"
            android:textColor="#4DC95A"
            android:fontFamily="sans-serif-medium"
            android:alpha="0"/>

        <TextView android:id="@+id/splash_subtitle"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="محرر لغة VCG البرمجية السورية"
            android:textSize="14sp" android:textColor="#888888"
            android:layout_marginTop="8dp"
            android:alpha="0"/>

        <TextView android:id="@+id/splash_version"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="v2.0.0 · 2026-06-06"
            android:textSize="12sp" android:textColor="#666666"
            android:fontFamily="monospace"
            android:layout_marginTop="4dp"
            android:alpha="0"/>

        <!-- نقاط تحميل نابضة -->
        <LinearLayout android:id="@+id/loading_dots"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center"
            android:layout_marginTop="36dp" android:alpha="0">

            <View android:id="@+id/dot1"
                android:layout_width="9dp" android:layout_height="9dp"
                android:layout_marginEnd="7dp"
                android:background="@drawable/bg_loading_dot"/>

            <View android:id="@+id/dot2"
                android:layout_width="9dp" android:layout_height="9dp"
                android:layout_marginEnd="7dp"
                android:background="@drawable/bg_loading_dot"/>

            <View android:id="@+id/dot3"
                android:layout_width="9dp" android:layout_height="9dp"
                android:background="@drawable/bg_loading_dot"/>
        </LinearLayout>

    </LinearLayout>
</FrameLayout>
