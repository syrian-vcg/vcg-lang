<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="22dp" android:paddingTop="6dp">

    <TextView
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="سيتم فتح تطبيق البريد لإرسال اقتراحك إلى فريق VCG Editor."
        android:textColor="?attr/colorTextMuted" android:textSize="12.5sp"
        android:paddingBottom="12dp"/>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="اكتب اقتراحك هنا...">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/input_suggestion"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minLines="4" android:gravity="top|start"
            android:inputType="textMultiLine|textCapSentences"/>
    </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>
