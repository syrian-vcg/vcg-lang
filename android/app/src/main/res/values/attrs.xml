<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Theme-able color attributes.
        Every screen reads colors through these attrs (?attr/colorX) instead of
        fixed @color/x references, so switching the app theme in Settings
        (Black / Dark / White / Blue) re-skins the whole app without code changes.
    -->
    <!-- Note: colorSurface itself is already declared by Material Components,
         we reuse that one directly (it is also what Material widgets read for
         elevation overlays), so only the extra ones are declared here. -->
    <attr name="colorBg" format="color"/>
    <attr name="colorSurface2" format="color"/>
    <attr name="colorCodeBg" format="color"/>
    <attr name="colorBorder" format="color"/>
    <attr name="colorAccentPrimary" format="color"/>
    <attr name="colorAccentSecondary" format="color"/>
    <attr name="colorAccentLight" format="color"/>
    <attr name="colorGold" format="color"/>
    <attr name="colorTextPrimary" format="color"/>
    <attr name="colorTextMuted" format="color"/>
    <attr name="colorErrorText" format="color"/>
    <attr name="colorInfoText" format="color"/>
    <attr name="colorStatusBar" format="color"/>
    <attr name="isDarkTheme" format="boolean"/>
</resources>
