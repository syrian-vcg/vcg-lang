# ╔══════════════════════════════════════════════════════════════╗
# ║  main.vcg — مثال تطبيق VCG كامل مع ميزات البناء الجديدة    ║
# ╚══════════════════════════════════════════════════════════════╝

# ═══════════════════════════════════════════════════════
#  1. إعدادات التطبيق الأساسية — يجب أن تكون في أول ملف
# ═══════════════════════════════════════════════════════

$set.name_app("تطبيقي الرائع")
$set.app.package("com.example.myapp")
$set.app.version("1.0.0")
$set.get.icon("assets/icon.png")

# ═══════════════════════════════════════════════════════
#  2. تخزين البيانات — data_vcg و get.data
# ═══════════════════════════════════════════════════════

# تعريف بيانات مخزّنة في قاعدة بيانات التطبيق
data_vcg users = [
    { id: 1, name: "أحمد", age: 25 },
    { id: 2, name: "سامر", age: 30 },
    { id: 3, name: "ليلى", age: 22 }
]

data_vcg app_config = {
    theme:    "olive",
    language: "ar",
    version:  "1.0.0"
}

# قراءة البيانات المخزّنة
let all_users  = get.data(users)
let config     = get.data(app_config)

show("المستخدمون:", all_users)
show("الثيم الحالي:", config.theme)

# ═══════════════════════════════════════════════════════
#  3. الواجهة الرئيسية
# ═══════════════════════════════════════════════════════

h("مرحباً بك في " + $set.name_app())
l("الإصدار: " + $set.app.version())

btn("عرض المستخدمين", func() {
    let i = 0
    while i < len(all_users) {
        show("• " + all_users[i].name + " — العمر: " + all_users[i].age)
        i += 1
    }
})

# ═══════════════════════════════════════════════════════
#  4. تصدير التطبيق — APK + ZIP + PDF
# ═══════════════════════════════════════════════════════

# عند استدعاء export(to_set) يبدأ بناء المشروع كاملاً
# (APK + ملف ZIP + وثيقة PDF)
# يتم تشغيله تلقائياً عند فتح Generate_Stack.apk.yml

export(to_set)
