<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="?attr/colorCodeBg">

    <!-- Topbar -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:elevation="6dp">

        <androidx.appcompat.widget.Toolbar android:id="@+id/editor_toolbar"
            android:layout_width="match_parent" android:layout_height="64dp"
            android:background="?attr/colorSurface"
            app:contentInsetStart="0dp" app:contentInsetEnd="0dp"
            app:contentInsetLeft="0dp" app:contentInsetRight="0dp">

            <LinearLayout
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="6dp" android:paddingEnd="10dp">

                <!-- Back -->
                <ImageButton
                    android:id="@+id/btn_back"
                    android:layout_width="40dp" android:layout_height="40dp"
                    android:background="@drawable/bg_topbar_circle_btn"
                    android:src="@drawable/ic_topbar_back"
                    app:tint="?attr/colorTextPrimary"
                    android:contentDescription="رجوع"
                    android:padding="9dp"/>

                <!-- File badge -->
                <FrameLayout
                    android:layout_width="38dp" android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_topbar_icon"
                    android:elevation="2dp">
                    <ImageView
                        android:layout_width="20dp" android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_topbar_code"/>
                </FrameLayout>

                <!-- Title block -->
                <LinearLayout
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="10dp">

                    <LinearLayout
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:id="@+id/tv_editor_title"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textColor="?attr/colorTextPrimary"
                            android:textSize="16sp" android:textStyle="bold"
                            android:fontFamily="sans-serif-medium"
                            android:maxLines="1" android:ellipsize="end"/>
                        <View
                            android:id="@+id/dot_modified"
                            android:layout_width="7dp" android:layout_height="7dp"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_modified_dot"
                            android:visibility="invisible"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_editor_subtitle"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="?attr/colorTextMuted"
                        android:textSize="12sp"
                        android:maxLines="1" android:ellipsize="end"
                        android:layout_marginTop="1dp"/>
                </LinearLayout>

                <!-- More -->
                <ImageButton
                    android:id="@+id/btn_more"
                    android:layout_width="40dp" android:layout_height="40dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_topbar_circle_btn"
                    android:src="@drawable/ic_toolbar_more"
                    android:padding="9dp"
                    android:contentDescription="خيارات إضافية"
                    app:tint="?attr/colorTextMuted"/>
            </LinearLayout>
        </androidx.appcompat.widget.Toolbar>

        <View
            android:layout_width="match_parent" android:layout_height="2.5dp"
            android:background="@drawable/bg_topbar_accent_line"/>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Editor + Preview split -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="vertical">

        <!-- Code area: line numbers + editor -->
        <LinearLayout android:id="@+id/editor_code_container"
            android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:orientation="horizontal">

            <!-- Line numbers -->
            <ScrollView android:id="@+id/line_scroll"
                android:layout_width="38dp" android:layout_height="match_parent"
                android:background="?attr/colorSurface"
                android:overScrollMode="never"
                android:scrollbars="none">
                <TextView android:id="@+id/line_numbers"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textColor="?attr/colorTextMuted" android:textSize="14sp"
                    android:fontFamily="monospace" android:gravity="end"
                    android:paddingTop="8dp" android:paddingEnd="6dp"
                    android:paddingStart="4dp" android:lineSpacingMultiplier="1.35"
                    android:text="1"/>
            </ScrollView>

            <View android:layout_width="1dp" android:layout_height="match_parent"
                android:background="?attr/colorBorder"/>

            <!-- Code editor -->
            <ScrollView android:id="@+id/editor_scroll"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1"
                android:overScrollMode="never">
                <com.syrianvcg.editor.VcgCodeEditor android:id="@+id/code_editor"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:paddingTop="8dp"
                    android:textSize="14sp"
                    android:gravity="top|start"
                    android:inputType="textMultiLine|textNoSuggestions"
                    android:imeOptions="flagNoEnterAction"
                    android:scrollbars="none"
                    android:background="?attr/colorCodeBg"/>
            </ScrollView>
        </LinearLayout>

        <!-- Live preview pane -->
        <LinearLayout android:id="@+id/preview_container"
            android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:orientation="vertical"
            android:visibility="visible">

            <View android:layout_width="match_parent" android:layout_height="2dp"
                android:background="?attr/colorAccentSecondary"/>

            <TextView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="▦ معاينة مباشرة"
                android:textColor="?attr/colorAccentSecondary" android:textSize="11sp"
                android:textStyle="bold"
                android:background="?attr/colorSurface"
                android:padding="4dp" android:gravity="center"/>

            <FrameLayout
                android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_weight="1">

                <WebView android:id="@+id/preview_webview"
                    android:layout_width="match_parent" android:layout_height="match_parent"/>

                <com.syrianvcg.editor.VcgSkeletonView android:id="@+id/preview_skeleton"
                    android:layout_width="match_parent" android:layout_height="match_parent"
                    android:background="?attr/colorBg"/>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Quick keyboard -->
    <HorizontalScrollView android:id="@+id/quick_keyboard_scroll"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:scrollbars="none"
        android:paddingTop="4dp" android:paddingBottom="4dp">
        <LinearLayout android:id="@+id/quick_keyboard"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="8dp" android:paddingEnd="8dp"
            android:gravity="center_vertical"/>
    </HorizontalScrollView>

    <!-- Professional bottom navigation bar -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_gravity="top"
            android:background="?attr/colorBorder"/>

        <LinearLayout
            android:id="@+id/editor_bottom_nav"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:layout_marginTop="1dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_bottom_nav"
            android:elevation="12dp"
            android:gravity="center_vertical">

            <!-- Save -->
            <LinearLayout
                android:id="@+id/nav_save"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="?attr/selectableItemBackground"
                android:clickable="true" android:focusable="true">
                <ImageView
                    android:layout_width="22dp" android:layout_height="22dp"
                    android:src="@drawable/ic_nav_save"
                    app:tint="?attr/colorTextMuted"/>
                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="حفظ"
                    android:textSize="10.5sp"
                    android:textColor="?attr/colorTextMuted"/>
            </LinearLayout>

            <!-- Insert media -->
            <LinearLayout
                android:id="@+id/btn_insert_asset"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="?attr/selectableItemBackground"
                android:clickable="true" android:focusable="true">
                <ImageView
                    android:layout_width="22dp" android:layout_height="22dp"
                    android:src="@drawable/ic_nav_insert"
                    app:tint="?attr/colorTextMuted"/>
                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="وسائط"
                    android:textSize="10.5sp"
                    android:textColor="?attr/colorTextMuted"/>
            </LinearLayout>

            <!-- Run (raised center action) -->
            <FrameLayout
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1.1"
                android:gravity="center">

                <LinearLayout
                    android:id="@+id/btn_run"
                    android:layout_width="58dp" android:layout_height="58dp"
                    android:layout_gravity="center"
                    android:layout_marginBottom="14dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_nav_fab"
                    android:elevation="8dp"
                    android:clickable="true" android:focusable="true">
                    <ImageView
                        android:layout_width="24dp" android:layout_height="24dp"
                        android:src="@drawable/ic_nav_run"/>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="6dp"
                    android:text="تشغيل"
                    android:textSize="10.5sp" android:textStyle="bold"
                    android:textColor="?attr/colorAccentPrimary"/>
            </FrameLayout>

            <!-- Preview toggle -->
            <LinearLayout
                android:id="@+id/btn_toggle_preview"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="?attr/selectableItemBackground"
                android:clickable="true" android:focusable="true">
                <ImageView
                    android:id="@+id/icon_toggle_preview"
                    android:layout_width="22dp" android:layout_height="22dp"
                    android:src="@drawable/ic_nav_preview"
                    app:tint="?attr/colorAccentSecondary"/>
                <TextView
                    android:id="@+id/lbl_toggle_preview"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="معاينة"
                    android:textSize="10.5sp"
                    android:textColor="?attr/colorAccentSecondary"/>
            </LinearLayout>

            <!-- Terminal -->
            <LinearLayout
                android:id="@+id/nav_terminal"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="?attr/selectableItemBackground"
                android:clickable="true" android:focusable="true">
                <ImageView
                    android:layout_width="22dp" android:layout_height="22dp"
                    android:src="@drawable/ic_nav_terminal"
                    app:tint="?attr/colorTextMuted"/>
                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Terminal"
                    android:textSize="10.5sp"
                    android:textColor="?attr/colorTextMuted"/>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
