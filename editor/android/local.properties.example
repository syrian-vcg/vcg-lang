# ════════════════════════════════════════════════════════════════
# نسخ هذا الملف إلى local.properties (بدون .example) وضع مفاتيحك
# الحقيقية من AdMob فيه. local.properties موجود في .gitignore ولن
# يُرفع إلى GitHub أبداً — هكذا يبقى حساب AdMob الحقيقي خاصاً بك حتى
# لو كان المستودع على GitHub عاماً (Public).
#
# إن تركت هذا الملف كما هو أو حذفته، سيستخدم المشروع تلقائياً أرقام
# AdMob الرسمية للاختبار (Test Ad Units) فقط — يبني بأمان، لكن لا
# يعرض إعلانات حقيقية ولا يحقق أي أرباح.
# ════════════════════════════════════════════════════════════════

# مسار Android SDK على جهازك (Android Studio يضبطه تلقائياً عادة)
#sdk.dir=/path/to/Android/sdk

# رقم تعريف تطبيق AdMob (AdMob App ID)
ADMOB_APP_ID=ca-app-pub-1525040025806904~6185155034

# رقم تعريف الوحدة الإعلانية المُجزية (Rewarded) — تُستخدم لمنح العملات
ADMOB_REWARDED_UNIT_ID=appca-app-pub-1525040025806904/3150465990
# رقم تعريف الوحدة الإعلانية البينية (Interstitial) — الوحدة الثانية
ADMOB_INTERSTITIAL_UNIT_ID=ca-app-pub-1525040025806904/5325469129
