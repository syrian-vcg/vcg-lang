<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_margin="5dp"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="8dp">

        <FrameLayout android:layout_width="match_parent" android:layout_height="120dp">
            <ImageView android:id="@+id/asset_thumb"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:background="@drawable/bg_asset_thumb"/>
            <ImageView android:id="@+id/asset_video_icon"
                android:layout_width="36dp" android:layout_height="36dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_media_play"
                android:visibility="gone"
                app:tint="?attr/colorAccentSecondary"/>
            <ImageButton android:id="@+id/btn_delete_asset"
                android:layout_width="32dp" android:layout_height="32dp"
                android:layout_gravity="top|end"
                android:layout_margin="2dp"
                android:src="@android:drawable/ic_menu_delete"
                android:background="@drawable/bg_chip"
                app:tint="?attr/colorTextMuted"
                android:contentDescription="Delete"/>
        </FrameLayout>

        <TextView android:id="@+id/asset_name"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="?attr/colorTextPrimary" android:textSize="12.5sp"
            android:maxLines="1" android:ellipsize="middle"
            android:paddingTop="6dp" android:fontFamily="monospace"/>

        <TextView android:id="@+id/asset_size"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="?attr/colorTextMuted" android:textSize="11sp"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>
