<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="?attr/colorBg">

    <!-- ═══ TopBar ═══ -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:elevation="0dp"
        android:background="?attr/colorSurface"
        app:liftOnScroll="true">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:background="?attr/colorSurface"
            android:paddingHorizontal="6dp"
            app:contentInsetStart="12dp">

            <!-- Logo badge + Title stacked -->
            <LinearLayout
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_gravity="center_vertical">

                <FrameLayout
                    android:layout_width="40dp" android:layout_height="40dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_about_logo_badge">
                    <ImageView
                        android:layout_width="24dp" android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_vcg_logo"
                        android:contentDescription="VCG"/>
                </FrameLayout>

                <LinearLayout
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Syrian VCG"
                        android:textColor="?attr/colorAccentSecondary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.03"/>

                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="مشاريعي · VCG Editor"
                        android:textColor="?attr/colorTextMuted"
                        android:textSize="11sp"
                        android:layout_marginTop="-1dp"/>
                </LinearLayout>
            </LinearLayout>

        </androidx.appcompat.widget.Toolbar>

        <!-- Accent line under toolbar -->
        <View
            android:layout_width="match_parent" android:layout_height="2dp"
            android:background="?attr/colorAccentPrimary"/>
        <View
            android:layout_width="match_parent" android:layout_height="1dp"
            android:background="?attr/colorBorder"/>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- ═══ Content ═══ -->
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Coin bar -->
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:background="?attr/colorSurface2">

            <TextView android:id="@+id/label_coin_balance_home"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🪙 0 عملة"
                android:textColor="?attr/colorGold"
                android:textSize="13.5sp"
                android:textStyle="bold"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_watch_ad_home"
                android:layout_width="wrap_content" android:layout_height="32dp"
                android:text="📺 اكسب عملات"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:insetTop="0dp" android:insetBottom="0dp"
                style="@style/VCGButtonSubtle"/>
        </LinearLayout>

        <!-- Empty state -->
        <TextView android:id="@+id/empty_view"
            android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:visibility="gone"
            android:text="لا يوجد مشاريع بعد\nاضغط + لإنشاء أول مشروع\nأو استورد ZIP من القائمة ⋮"
            android:textColor="?attr/colorTextMuted"
            android:textSize="15sp"
            android:lineSpacingMultiplier="1.6"
            android:textAlignment="center"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_projects"
            android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="10dp"
            android:clipToPadding="false"/>

        <FrameLayout
            android:id="@+id/banner_container"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:background="?attr/colorSurface"/>
    </LinearLayout>

    <!-- FAB -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_new_project"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:contentDescription="New Project"
        android:src="@android:drawable/ic_input_add"
        app:backgroundTint="?attr/colorAccentPrimary"
        app:tint="?attr/colorTextPrimary"
        app:fabSize="normal"
        app:elevation="6dp"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
