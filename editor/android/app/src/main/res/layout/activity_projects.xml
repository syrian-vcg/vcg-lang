<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="?attr/colorBg">

    <!-- ═══ TOP BAR ═══ -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:elevation="0dp"
        android:background="?attr/colorSurface"
        app:liftOnScroll="true">

        <!-- Toolbar فارغ لـ setSupportActionBar() فقط - بدون محتوى -->
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="?attr/colorSurface"/>

        <!-- TopBar الحقيقي -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:background="?attr/colorSurface"
            android:paddingHorizontal="8dp">

            <!-- يسار: لوغو + اسم -->
            <LinearLayout
                android:id="@+id/topbar_logo_area"
                android:layout_width="wrap_content" android:layout_height="match_parent"
                android:layout_alignParentStart="true"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="4dp">

                <TextView
                    android:layout_width="38dp" android:layout_height="38dp"
                    android:text="V"
                    android:textColor="?attr/colorBg"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:fontFamily="monospace"
                    android:background="@drawable/bg_nav_fab"/>

                <LinearLayout
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="10dp">

                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Syrian VCG"
                        android:textColor="?attr/colorAccentSecondary"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"/>

                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="مشاريعي"
                        android:textColor="?attr/colorTextMuted"
                        android:textSize="11sp"
                        android:layout_marginTop="-1dp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- يمين: زر ⋮ -->
            <ImageButton
                android:id="@+id/btn_more"
                android:layout_width="44dp" android:layout_height="44dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_toolbar_more"
                android:background="@drawable/bg_topbar_circle_btn"
                android:tint="?attr/colorTextMuted"
                android:contentDescription="القائمة"/>

        </RelativeLayout>

        <!-- خط فاصل -->
        <View
            android:layout_width="match_parent" android:layout_height="1.5dp"
            android:background="?attr/colorBorder"/>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- ═══ CONTENT ═══ -->
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- شريط العملات -->
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:background="?attr/colorSurface2">

            <TextView
                android:id="@+id/label_coin_balance_home"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🪙 0 عملة"
                android:textColor="?attr/colorGold"
                android:textSize="13.5sp"
                android:textStyle="bold"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_watch_ad_home"
                android:layout_width="wrap_content" android:layout_height="32dp"
                android:text="📺 اكسب عملات"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:insetTop="0dp" android:insetBottom="0dp"
                style="@style/VCGButtonSubtle"/>
        </LinearLayout>

        <!-- فاصل -->
        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="?attr/colorBorder"/>

        <!-- حالة فارغة -->
        <TextView android:id="@+id/empty_view"
            android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:visibility="gone"
            android:text="لا يوجد مشاريع بعد\nاضغط + لإنشاء أول مشروع\nأو استورد ZIP من القائمة ⋮"
            android:textColor="?attr/colorTextMuted"
            android:textSize="15sp"
            android:lineSpacingMultiplier="1.6"
            android:textAlignment="center"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_projects"
            android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="10dp"
            android:clipToPadding="false"/>

        <FrameLayout
            android:id="@+id/banner_container"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:background="?attr/colorSurface"/>
    </LinearLayout>

    <!-- FAB -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_new_project"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:contentDescription="مشروع جديد"
        android:src="@android:drawable/ic_input_add"
        app:backgroundTint="?attr/colorAccentPrimary"
        app:tint="?attr/colorBg"
        app:fabSize="normal"
        app:elevation="6dp"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
