<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="5dp"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_file_card_ripple"
        android:foreground="@drawable/bg_file_card_stroke"
        android:paddingHorizontal="14dp"
        android:paddingVertical="13dp">

        <!-- أيقونة: ملف أو مجلد (emoji يُعيَّن من الكود) -->
        <FrameLayout
            android:layout_width="46dp" android:layout_height="46dp"
            android:background="@drawable/bg_file_icon">
            <TextView
                android:id="@+id/file_icon_text"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="📄"
                android:textSize="22sp"
                android:contentDescription="أيقونة"/>
        </FrameLayout>

        <!-- معلومات العنصر -->
        <LinearLayout
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="13dp">

            <TextView android:id="@+id/file_name"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="?attr/colorTextPrimary"
                android:textSize="14.5sp"
                android:textStyle="bold"
                android:maxLines="1" android:ellipsize="end"
                android:fontFamily="monospace"/>

            <TextView android:id="@+id/file_preview"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="?attr/colorTextMuted"
                android:textSize="12sp"
                android:maxLines="1" android:ellipsize="end"
                android:paddingTop="3dp"
                android:alpha="0.85"/>

            <LinearLayout
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="6dp">

                <View
                    android:layout_width="5dp" android:layout_height="5dp"
                    android:background="@drawable/bg_live_dot"
                    android:layout_marginEnd="5dp"/>

                <TextView android:id="@+id/file_meta"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="?attr/colorAccentSecondary"
                    android:textSize="10.5sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.02"/>
            </LinearLayout>
        </LinearLayout>

        <!-- زر الخيارات -->
        <ImageButton android:id="@+id/btn_delete"
            android:layout_width="36dp" android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:padding="7dp"
            android:src="@drawable/ic_toolbar_more"
            android:background="@drawable/bg_topbar_circle_btn"
            app:tint="?attr/colorTextMuted"
            android:contentDescription="خيارات"/>
    </LinearLayout>

</androidx.cardview.widget.CardView>
