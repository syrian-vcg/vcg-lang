<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="5dp"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_file_card_ripple"
        android:foreground="@drawable/bg_folder_card_stroke"
        android:paddingHorizontal="14dp"
        android:paddingVertical="13dp">

        <!-- Folder icon badge: amber/gold gradient chip -->
        <FrameLayout
            android:layout_width="46dp" android:layout_height="46dp"
            android:background="@drawable/bg_folder_icon">
            <ImageView
                android:layout_width="23dp" android:layout_height="23dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_folder"
                app:tint="?attr/colorGold"
                android:contentDescription="Folder"/>
        </FrameLayout>

        <!-- Folder info -->
        <LinearLayout
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="13dp">

            <TextView android:id="@+id/folder_name"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="?attr/colorTextPrimary"
                android:textSize="14.5sp"
                android:textStyle="bold"
                android:maxLines="1" android:ellipsize="end"
                android:fontFamily="monospace"/>

            <!-- Item-count pill, same rhythm as the file card's meta row -->
            <LinearLayout
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="6dp">

                <ImageView
                    android:layout_width="11dp" android:layout_height="11dp"
                    android:src="@drawable/ic_file_vcg_badge"
                    app:tint="?attr/colorTextMuted"
                    android:alpha="0.7"
                    android:layout_marginEnd="5dp"/>

                <TextView android:id="@+id/folder_count"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="?attr/colorTextMuted"
                    android:textSize="11sp"
                    android:fontFamily="monospace"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Open chevron -->
        <ImageView
            android:layout_width="18dp" android:layout_height="18dp"
            android:src="@drawable/ic_topbar_back"
            android:rotation="180"
            app:tint="?attr/colorTextMuted"
            android:alpha="0.6"
            android:layout_marginEnd="2dp"
            android:contentDescription="Open"/>

        <!-- More (rename / delete) -->
        <ImageButton android:id="@+id/btn_delete"
            android:layout_width="36dp" android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:padding="7dp"
            android:src="@drawable/ic_toolbar_more"
            android:background="@drawable/bg_topbar_circle_btn"
            android:tint="?attr/colorTextMuted"
            android:contentDescription="خيارات المجلد"/>
    </LinearLayout>

</androidx.cardview.widget.CardView>
