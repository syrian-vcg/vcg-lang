<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorCodeBg">

    <!-- ═══════════════════════════════════════
         TOP BAR
    ════════════════════════════════════════ -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:elevation="0dp"
        android:background="?attr/colorSurface">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/editor_toolbar"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="?attr/colorSurface"
            android:paddingHorizontal="6dp"
            app:contentInsetStart="0dp"
            app:contentInsetEnd="0dp">

            <!-- ⋮ Menu button (LEFT) -->
            <ImageButton
                android:id="@+id/btn_more"
                android:layout_width="44dp" android:layout_height="44dp"
                android:layout_gravity="start|center_vertical"
                android:src="@drawable/ic_toolbar_more"
                android:background="@drawable/bg_topbar_circle_btn"
                app:tint="?attr/colorTextMuted"
                android:contentDescription="خيارات"/>

            <!-- File name + project name (CENTER) -->
            <LinearLayout
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/toolbar_title"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="main.vcg"
                    android:textColor="?attr/colorAccentSecondary"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.02"/>

                <TextView
                    android:id="@+id/toolbar_subtitle"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="mydoc offline"
                    android:textColor="?attr/colorTextMuted"
                    android:textSize="11sp"
                    android:layout_marginTop="-1dp"/>
            </LinearLayout>

            <!-- → Run button (RIGHT) -->
            <LinearLayout
                android:id="@+id/btn_run_top"
                android:layout_width="44dp" android:layout_height="44dp"
                android:layout_gravity="end|center_vertical"
                android:gravity="center"
                android:background="@drawable/bg_topbar_run_btn"
                android:clickable="true" android:focusable="true">

                <ImageView
                    android:layout_width="20dp" android:layout_height="20dp"
                    android:src="@drawable/ic_nav_run"
                    app:tint="?attr/colorBg"/>
            </LinearLayout>

        </androidx.appcompat.widget.Toolbar>

        <!-- Accent line -->
        <View
            android:layout_width="match_parent" android:layout_height="1.5dp"
            android:background="?attr/colorBorder"/>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- ═══════════════════════════════════════
         EDITOR + PREVIEW
    ════════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="vertical">

        <!-- Code area -->
        <LinearLayout
            android:id="@+id/editor_code_container"
            android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:orientation="horizontal">

            <!-- Line numbers column -->
            <ScrollView
                android:id="@+id/line_scroll"
                android:layout_width="44dp" android:layout_height="match_parent"
                android:background="?attr/colorSurface"
                android:overScrollMode="never"
                android:scrollbars="none">

                <TextView
                    android:id="@+id/line_numbers"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="1"
                    android:textColor="?attr/colorTextMuted"
                    android:textSize="13.5sp"
                    android:fontFamily="monospace"
                    android:gravity="end"
                    android:paddingTop="10dp"
                    android:paddingEnd="8dp"
                    android:paddingStart="4dp"
                    android:lineSpacingMultiplier="1.38"
                    android:alpha="0.55"/>
            </ScrollView>

            <!-- Thin separator -->
            <View
                android:layout_width="1dp" android:layout_height="match_parent"
                android:background="?attr/colorBorder"/>

            <!-- Code editor -->
            <ScrollView
                android:id="@+id/editor_scroll"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1"
                android:overScrollMode="never">

                <com.syrianvcg.editor.VcgCodeEditor
                    android:id="@+id/code_editor"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:padding="10dp"
                    android:paddingTop="10dp"
                    android:textSize="14.5sp"
                    android:lineSpacingMultiplier="1.38"
                    android:gravity="top|start"
                    android:inputType="textMultiLine|textNoSuggestions"
                    android:imeOptions="flagNoEnterAction"
                    android:scrollbars="none"
                    android:background="?attr/colorCodeBg"
                    android:fontFamily="monospace"/>
            </ScrollView>
        </LinearLayout>

        <!-- ══ Live Preview pane ══ -->
        <LinearLayout
            android:id="@+id/preview_container"
            android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:orientation="vertical"
            android:visibility="visible">

            <!-- Preview header bar -->
            <LinearLayout
                android:layout_width="match_parent" android:layout_height="34dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="?attr/colorSurface"
                android:paddingHorizontal="12dp">

                <!-- Green dot indicator -->
                <View
                    android:layout_width="7dp" android:layout_height="7dp"
                    android:background="@drawable/bg_live_dot"
                    android:layout_marginEnd="7dp"/>

                <TextView
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="معاينة مباشرة"
                    android:textColor="?attr/colorAccentSecondary"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"/>

                <!-- Fullscreen toggle -->
                <ImageButton
                    android:id="@+id/btn_fullscreen_preview"
                    android:layout_width="28dp" android:layout_height="28dp"
                    android:src="@android:drawable/ic_menu_zoom"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="?attr/colorTextMuted"
                    android:contentDescription="ملء الشاشة"/>
            </LinearLayout>

            <!-- Accent line -->
            <View
                android:layout_width="match_parent" android:layout_height="2dp"
                android:background="?attr/colorAccentSecondary"/>

            <FrameLayout
                android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_weight="1">

                <WebView
                    android:id="@+id/preview_webview"
                    android:layout_width="match_parent" android:layout_height="match_parent"/>

                <com.syrianvcg.editor.VcgSkeletonView
                    android:id="@+id/preview_skeleton"
                    android:layout_width="match_parent" android:layout_height="match_parent"
                    android:background="?attr/colorBg"/>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ═══════════════════════════════════════
         QUICK KEYBOARD SHORTCUTS
    ════════════════════════════════════════ -->
    <HorizontalScrollView
        android:id="@+id/quick_keyboard_scroll"
        android:layout_width="match_parent" android:layout_height="42dp"
        android:background="?attr/colorSurface"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/quick_keyboard"
            android:layout_width="wrap_content" android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="6dp"
            android:divider="@drawable/divider_keyboard"
            android:showDividers="middle"/>
    </HorizontalScrollView>

    <!-- Keyboard / Nav separator -->
    <View
        android:layout_width="match_parent" android:layout_height="1dp"
        android:background="?attr/colorBorder"/>

    <!-- ═══════════════════════════════════════
         BOTTOM NAVIGATION
    ════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/editor_bottom_nav"
        android:layout_width="match_parent" android:layout_height="66dp"
        android:orientation="horizontal"
        android:background="?attr/colorSurface"
        android:elevation="12dp"
        android:gravity="center_vertical">

        <!-- Terminal -->
        <LinearLayout
            android:id="@+id/nav_terminal"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical" android:gravity="center"
            android:background="?attr/selectableItemBackground"
            android:clickable="true" android:focusable="true">

            <ImageView
                android:layout_width="22dp" android:layout_height="22dp"
                android:src="@drawable/ic_nav_terminal"
                app:tint="?attr/colorTextMuted"/>

            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Terminal"
                android:textSize="10sp"
                android:textColor="?attr/colorTextMuted"
                android:fontFamily="monospace"/>
        </LinearLayout>

        <!-- Preview toggle -->
        <LinearLayout
            android:id="@+id/btn_toggle_preview"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical" android:gravity="center"
            android:background="?attr/selectableItemBackground"
            android:clickable="true" android:focusable="true">

            <ImageView
                android:id="@+id/icon_toggle_preview"
                android:layout_width="22dp" android:layout_height="22dp"
                android:src="@drawable/ic_nav_preview"
                app:tint="?attr/colorAccentSecondary"/>

            <TextView
                android:id="@+id/lbl_toggle_preview"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="إخفاء"
                android:textSize="10sp"
                android:textColor="?attr/colorAccentSecondary"/>
        </LinearLayout>

        <!-- ▶ RUN (center raised FAB style) -->
        <FrameLayout
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1.2"
            android:gravity="center">

            <LinearLayout
                android:id="@+id/btn_run"
                android:layout_width="56dp" android:layout_height="56dp"
                android:layout_gravity="center"
                android:layout_marginBottom="12dp"
                android:orientation="vertical" android:gravity="center"
                android:background="@drawable/bg_nav_fab"
                android:elevation="10dp"
                android:clickable="true" android:focusable="true">

                <ImageView
                    android:layout_width="26dp" android:layout_height="26dp"
                    android:src="@drawable/ic_nav_run"/>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="5dp"
                android:text="تشغيل"
                android:textSize="10sp" android:textStyle="bold"
                android:textColor="?attr/colorAccentPrimary"/>
        </FrameLayout>

        <!-- Assets / Media -->
        <LinearLayout
            android:id="@+id/btn_insert_asset"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical" android:gravity="center"
            android:background="?attr/selectableItemBackground"
            android:clickable="true" android:focusable="true">

            <ImageView
                android:layout_width="22dp" android:layout_height="22dp"
                android:src="@drawable/ic_nav_insert"
                app:tint="?attr/colorTextMuted"/>

            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="وسائط"
                android:textSize="10sp"
                android:textColor="?attr/colorTextMuted"/>
        </LinearLayout>

        <!-- Save -->
        <LinearLayout
            android:id="@+id/nav_save"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical" android:gravity="center"
            android:background="?attr/selectableItemBackground"
            android:clickable="true" android:focusable="true">

            <ImageView
                android:layout_width="22dp" android:layout_height="22dp"
                android:src="@drawable/ic_nav_save"
                app:tint="?attr/colorTextMuted"/>

            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="حفظ"
                android:textSize="10sp"
                android:textColor="?attr/colorTextMuted"/>
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
