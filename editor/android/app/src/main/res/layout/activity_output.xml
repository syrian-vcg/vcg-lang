<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="?attr/colorBg">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent" android:layout_height="wrap_content">
        <androidx.appcompat.widget.Toolbar android:id="@+id/output_toolbar"
            android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorSurface"
            app:titleTextColor="?attr/colorAccentSecondary"/>
    </com.google.android.material.appbar.AppBarLayout>

    <ProgressBar android:id="@+id/progress_bar"
        android:layout_width="match_parent" android:layout_height="4dp"
        android:visibility="gone"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:progressTint="?attr/colorAccentSecondary"/>

    <FrameLayout
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1">

        <WebView android:id="@+id/web_view"
            android:layout_width="match_parent" android:layout_height="match_parent"/>

        <com.syrianvcg.editor.VcgSkeletonView android:id="@+id/output_skeleton"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:background="?attr/colorBg"/>
    </FrameLayout>
</LinearLayout>
