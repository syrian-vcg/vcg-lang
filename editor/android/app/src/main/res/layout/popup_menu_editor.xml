<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="248dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_popup_card"
    android:elevation="16dp"
    android:paddingTop="6dp"
    android:paddingBottom="8dp">

    <!-- Header -->
    <TextView
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="خيارات المحرر"
        android:textColor="?attr/colorTextMuted"
        android:textSize="11.5sp"
        android:textStyle="bold"
        android:letterSpacing="0.02"
        android:paddingStart="16dp" android:paddingEnd="16dp"
        android:paddingTop="6dp" android:paddingBottom="8dp"/>

    <View
        android:layout_width="match_parent" android:layout_height="1dp"
        android:background="?attr/colorBorder"
        android:layout_marginBottom="4dp"/>

    <!-- Share -->
    <LinearLayout
        android:id="@+id/popup_item_share"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="10dp" android:paddingEnd="14dp"
        android:paddingTop="9dp" android:paddingBottom="9dp"
        android:layout_marginStart="6dp" android:layout_marginEnd="6dp"
        android:background="@drawable/bg_popup_item"
        android:clickable="true" android:focusable="true">

        <FrameLayout
            android:layout_width="34dp" android:layout_height="34dp"
            android:background="@drawable/bg_popup_icon_badge">
            <ImageView
                android:layout_width="18dp" android:layout_height="18dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_popup_share"
                app:tint="?attr/colorAccentSecondary"/>
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp">
            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="مشاركة الكود"
                android:textColor="?attr/colorTextPrimary"
                android:textSize="14sp" android:textStyle="bold"/>
            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="إرسال الملف إلى تطبيق آخر"
                android:textColor="?attr/colorTextMuted"
                android:textSize="11sp"
                android:layout_marginTop="1dp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Terminal -->
    <LinearLayout
        android:id="@+id/popup_item_terminal"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="10dp" android:paddingEnd="14dp"
        android:paddingTop="9dp" android:paddingBottom="9dp"
        android:layout_marginStart="6dp" android:layout_marginEnd="6dp"
        android:background="@drawable/bg_popup_item"
        android:clickable="true" android:focusable="true">

        <FrameLayout
            android:layout_width="34dp" android:layout_height="34dp"
            android:background="@drawable/bg_popup_icon_badge">
            <ImageView
                android:layout_width="18dp" android:layout_height="18dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_nav_terminal"
                app:tint="?attr/colorAccentSecondary"/>
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp">
            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="الطرفية Terminal"
                android:textColor="?attr/colorTextPrimary"
                android:textSize="14sp" android:textStyle="bold"/>
            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="تشغيل الكود في وحدة تحكم"
                android:textColor="?attr/colorTextMuted"
                android:textSize="11sp"
                android:layout_marginTop="1dp"/>
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent" android:layout_height="1dp"
        android:background="?attr/colorBorder"
        android:layout_marginTop="4dp" android:layout_marginBottom="4dp"/>

    <!-- Close editor -->
    <LinearLayout
        android:id="@+id/popup_item_close"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="10dp" android:paddingEnd="14dp"
        android:paddingTop="9dp" android:paddingBottom="9dp"
        android:layout_marginStart="6dp" android:layout_marginEnd="6dp"
        android:background="@drawable/bg_popup_item"
        android:clickable="true" android:focusable="true">

        <FrameLayout
            android:layout_width="34dp" android:layout_height="34dp"
            android:background="@drawable/bg_popup_icon_badge_danger">
            <ImageView
                android:layout_width="18dp" android:layout_height="18dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_popup_close"
                app:tint="?attr/colorErrorText"/>
        </FrameLayout>

        <TextView
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="إغلاق المحرر"
            android:textColor="?attr/colorErrorText"
            android:textSize="14sp" android:textStyle="bold"
            android:paddingStart="12dp"/>
    </LinearLayout>

</LinearLayout>
