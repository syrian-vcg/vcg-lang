<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="?attr/colorBg">

    <LinearLayout
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical" android:gravity="center">

        <!-- غلاف الشعار: توهّج نابض في الخلف + طبقات الشعار المبنية تدريجياً في الأمام -->
        <FrameLayout
            android:layout_width="170dp" android:layout_height="170dp"
            android:layout_gravity="center">

            <ImageView android:id="@+id/splash_glow"
                android:layout_width="142dp" android:layout_height="142dp"
                android:layout_gravity="center"
                android:src="@drawable/bg_splash_glow"
                android:alpha="0"
                android:contentDescription="@null"/>

            <FrameLayout android:id="@+id/splash_logo_layers"
                android:layout_width="108dp" android:layout_height="108dp"
                android:layout_gravity="center"
                android:clipChildren="true">

                <ImageView android:id="@+id/layer_square"
                    android:layout_width="match_parent" android:layout_height="match_parent"
                    android:src="@drawable/ic_splash_square" android:contentDescription="@null"/>

                <ImageView android:id="@+id/layer_star_small"
                    android:layout_width="match_parent" android:layout_height="match_parent"
                    android:src="@drawable/ic_splash_star_small" android:contentDescription="@null"/>

                <ImageView android:id="@+id/layer_star_medium"
                    android:layout_width="match_parent" android:layout_height="match_parent"
                    android:src="@drawable/ic_splash_star_medium" android:contentDescription="@null"/>

                <ImageView android:id="@+id/layer_star_large"
                    android:layout_width="match_parent" android:layout_height="match_parent"
                    android:src="@drawable/ic_splash_star_large" android:contentDescription="@null"/>

                <ImageView android:id="@+id/layer_letter_v"
                    android:layout_width="match_parent" android:layout_height="match_parent"
                    android:src="@drawable/ic_splash_letter_v" android:contentDescription="@null"/>

                <ImageView android:id="@+id/layer_letter_c"
                    android:layout_width="match_parent" android:layout_height="match_parent"
                    android:src="@drawable/ic_splash_letter_c" android:contentDescription="@null"/>

                <ImageView android:id="@+id/layer_letter_g"
                    android:layout_width="match_parent" android:layout_height="match_parent"
                    android:src="@drawable/ic_splash_letter_g" android:contentDescription="@null"/>

                <!-- شريط البريق المتحرك، يبدأ خارج الحدود يساراً ويُحرَّك إلى يمين الشعار -->
                <ImageView android:id="@+id/layer_shine"
                    android:layout_width="46dp" android:layout_height="170dp"
                    android:layout_gravity="center"
                    android:src="@drawable/bg_splash_shine"
                    android:rotation="22"
                    android:alpha="0"
                    android:contentDescription="@null"/>

            </FrameLayout>
        </FrameLayout>

        <TextView android:id="@+id/splash_title"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="Syrian VCG Editor"
            android:textSize="26sp" android:textStyle="bold"
            android:textColor="?attr/colorAccentSecondary"
            android:fontFamily="sans-serif-medium"/>

        <TextView android:id="@+id/splash_subtitle"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="محرر لغة VCG البرمجية السورية"
            android:textSize="14sp" android:textColor="?attr/colorTextMuted"
            android:layout_marginTop="8dp"/>

        <TextView android:id="@+id/splash_version"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="v2.0.0 · 2026-06-06"
            android:textSize="12sp" android:textColor="?attr/colorTextMuted"
            android:fontFamily="monospace"
            android:layout_marginTop="4dp"/>

        <!-- نقاط تحميل نابضة: تتموّج الواحدة تلو الأخرى طوال مدة الانتظار -->
        <LinearLayout android:id="@+id/loading_dots"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center"
            android:layout_marginTop="36dp" android:alpha="0">

            <View android:id="@+id/dot1"
                android:layout_width="9dp" android:layout_height="9dp"
                android:layout_marginEnd="7dp"
                android:background="@drawable/bg_loading_dot"/>

            <View android:id="@+id/dot2"
                android:layout_width="9dp" android:layout_height="9dp"
                android:layout_marginEnd="7dp"
                android:background="@drawable/bg_loading_dot"/>

            <View android:id="@+id/dot3"
                android:layout_width="9dp" android:layout_height="9dp"
                android:background="@drawable/bg_loading_dot"/>
        </LinearLayout>

    </LinearLayout>
</FrameLayout>
