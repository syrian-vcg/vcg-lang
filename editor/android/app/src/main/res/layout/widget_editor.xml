<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_widget_outer"
    android:elevation="3dp">

    <!-- ══════════════ Header: logo badge + name + open-app tap target ══════════════ -->
    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_widget_header"
        android:paddingStart="12dp"
        android:paddingEnd="10dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <FrameLayout
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/bg_widget_logo"
            android:layout_marginEnd="10dp">
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_vcg_logo"/>
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_app_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_tagline"
                android:textColor="@color/text_muted"
                android:textSize="10sp"/>
        </LinearLayout>

        <ImageView
            android:id="@+id/widget_btn_settings"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:padding="6dp"
            android:src="@drawable/ic_shortcut_settings"/>
    </LinearLayout>

    <!-- ── thin divider ──
         ⚠️ Android 14: عنصر <View> العادي غير مدعوم داخل RemoteViews
         (نظام تطبيقات الودجت يقبل فقط FrameLayout/LinearLayout/RelativeLayout/
         GridLayout + عناصر widgets محددة). كان هذا يسبّب فشل تنفيخ التخطيط
         بالكامل عند المُشغّل، فلا يظهر الودجت إطلاقاً. FrameLayout بديل آمن
         ومدعوم يعطي نفس النتيجة البصرية (خط رفيع بلون الخلفية). -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_color"/>

    <!-- ══════════════ Last project row ══════════════ -->
    <LinearLayout
        android:id="@+id/widget_last_project"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="12dp">

        <ImageView
            android:id="@+id/widget_project_dot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:src="@drawable/bg_widget_dot"
            android:layout_marginEnd="10dp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_project_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/widget_no_projects"
                android:textColor="@color/text_muted"
                android:textSize="10.5sp"/>

            <TextView
                android:id="@+id/widget_project_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/widget_last_project"
                android:textColor="@color/text_primary"
                android:textSize="15.5sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"/>
        </LinearLayout>

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_widget_chevron"/>
    </LinearLayout>

    <!-- ── thin divider ── -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_color"/>

    <!-- ══════════════ Action row ══════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp">

        <LinearLayout
            android:id="@+id/widget_btn_new"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_widget_primary"
            android:layout_marginEnd="6dp">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_widget_add"
                android:layout_marginEnd="6dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/shortcut_new_project_short"
                android:textColor="#FFFFFF"
                android:textSize="12.5sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_btn_terminal"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_widget_action">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_widget_terminal"
                android:layout_marginEnd="6dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/shortcut_terminal_short"
                android:textColor="@color/olive_green"
                android:textSize="12.5sp"
                android:textStyle="bold"/>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
