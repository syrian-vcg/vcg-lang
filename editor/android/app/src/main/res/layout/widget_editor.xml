<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_widget_card"
    android:padding="14dp">

    <!-- ── Header: logo + app name ───────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_vcg_logo"
            android:layout_marginEnd="8dp"/>

        <TextView
            android:id="@+id/widget_app_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- ── Last project card ─────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/widget_last_project"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:background="@drawable/bg_widget_action"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:layout_marginBottom="10dp">

        <TextView
            android:id="@+id/widget_project_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/widget_no_projects"
            android:textColor="@color/text_muted"
            android:textSize="11sp"/>

        <TextView
            android:id="@+id/widget_project_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/widget_last_project"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"/>
    </LinearLayout>

    <!-- ── Action row ────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_btn_new"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/bg_widget_primary"
            android:text="@string/shortcut_new_project_short"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginEnd="6dp"/>

        <TextView
            android:id="@+id/widget_btn_terminal"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/bg_widget_action"
            android:text="@string/shortcut_terminal_short"
            android:textColor="@color/olive_green"
            android:textSize="12sp"
            android:textStyle="bold"/>
    </LinearLayout>

</LinearLayout>
