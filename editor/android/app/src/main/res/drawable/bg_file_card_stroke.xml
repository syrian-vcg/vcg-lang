<?xml version="1.0" encoding="utf-8"?>
<!-- Card outline: a hairline border tinted with the theme border color,
     giving cards definition on both light and dark themes without relying
     on shadows (which look muddy on AMOLED/black theme). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent"/>
    <corners android:radius="16dp"/>
    <stroke android:width="1dp" android:color="?attr/colorBorder"/>
</shape>
