<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Main app theme -->
    <style name="Theme.VCGEditor" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/olive_green</item>
        <item name="colorPrimaryVariant">@color/bg_dark</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSecondary">@color/accent_green</item>
        <item name="colorOnSecondary">@android:color/white</item>
        <item name="android:colorBackground">@color/bg_dark</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:statusBarColor">@color/status_bar</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_muted</item>
        <item name="toolbarStyle">@style/VCGToolbar</item>
    </style>

    <!-- Toolbar: white surface, subtle bottom divider, dark title -->
    <style name="VCGToolbar" parent="Widget.MaterialComponents.Toolbar">
        <item name="android:background">@color/surface_dark</item>
        <item name="titleTextColor">@color/text_primary</item>
        <item name="subtitleTextColor">@color/text_muted</item>
        <item name="android:elevation">2dp</item>
    </style>

    <!-- Splash theme (no action bar) -->
    <style name="Theme.VCGEditor.Splash" parent="Theme.VCGEditor">
        <item name="android:windowFullscreen">false</item>
    </style>

    <!-- Custom dialog style -->
    <style name="VCGDialog" parent="Theme.MaterialComponents.DayNight.Dialog.Alert">
        <item name="colorPrimary">@color/olive_green</item>
        <item name="android:colorBackground">@color/surface_dark</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_muted</item>
        <item name="buttonBarPositiveButtonStyle">@style/VCGButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/VCGButtonOutlined</item>
    </style>

    <style name="VCGButton" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/olive_green</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="VCGButtonOutlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/border_color</item>
        <item name="strokeWidth">1.4dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="rippleColor">@color/accent_light</item>
    </style>

    <!-- Flat secondary action button (e.g. insert asset / toggle preview) -->
    <style name="VCGButtonSubtle" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/surface_dark_2</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="elevation">0dp</item>
        <item name="rippleColor">@color/accent_light</item>
    </style>
</resources>
