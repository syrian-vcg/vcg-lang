<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ════════════════════════════════════════════════════════════════
         Base theme — declares structure shared by all 4 app themes.
         Each concrete theme below only overrides the color attrs.
         ════════════════════════════════════════════════════════════════ -->
    <style name="Theme.VCGEditor.Base" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorOnSecondary">@android:color/white</item>
        <item name="toolbarStyle">@style/VCGToolbar</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
    </style>

    <!-- ───────────── White (clean / professional, default) ───────────── -->
    <style name="Theme.VCGEditor.White" parent="Theme.VCGEditor.Base">
        <item name="isDarkTheme">false</item>
        <item name="colorBg">#FFFFFF</item>
        <item name="colorSurface2">#F0F3EF</item>
        <item name="colorCodeBg">#FFFFFF</item>
        <item name="colorBorder">#E2E6E1</item>
        <item name="colorAccentPrimary">#1F7A3D</item>
        <item name="colorAccentSecondary">#2E9E44</item>
        <item name="colorAccentLight">#E6F4E8</item>
        <item name="colorGold">#B4790C</item>
        <item name="colorTextPrimary">#1B221C</item>
        <item name="colorTextMuted">#6B7568</item>
        <item name="colorErrorText">#D6483C</item>
        <item name="colorInfoText">#2563EB</item>
        <item name="colorStatusBar">#FFFFFF</item>
        <item name="colorPrimary">#1F7A3D</item>
        <item name="colorPrimaryVariant">#FFFFFF</item>
        <item name="colorSecondary">#2E9E44</item>
        <item name="android:colorBackground">#FFFFFF</item>
        <item name="colorSurface">#FFFFFF</item>
        <item name="colorOnSurface">#1B221C</item>
        <item name="android:statusBarColor">#FFFFFF</item>
        <item name="android:navigationBarColor">#FFFFFF</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
        <item name="android:textColorPrimary">#1B221C</item>
        <item name="android:textColorSecondary">#6B7568</item>
    </style>

    <!-- ───────────── Dark (charcoal, easy on the eyes) ───────────── -->
    <style name="Theme.VCGEditor.Dark" parent="Theme.VCGEditor.Base">
        <item name="isDarkTheme">true</item>
        <item name="colorBg">#15181A</item>
        <item name="colorSurface2">#23282B</item>
        <item name="colorCodeBg">#1A1D1F</item>
        <item name="colorBorder">#33383B</item>
        <item name="colorAccentPrimary">#3FBF6B</item>
        <item name="colorAccentSecondary">#4DD97A</item>
        <item name="colorAccentLight">#22301F</item>
        <item name="colorGold">#E0A93D</item>
        <item name="colorTextPrimary">#F1F3F1</item>
        <item name="colorTextMuted">#9AA39C</item>
        <item name="colorErrorText">#FF6B6B</item>
        <item name="colorInfoText">#5B9CFF</item>
        <item name="colorStatusBar">#15181A</item>
        <item name="colorPrimary">#3FBF6B</item>
        <item name="colorPrimaryVariant">#15181A</item>
        <item name="colorSecondary">#4DD97A</item>
        <item name="android:colorBackground">#15181A</item>
        <item name="colorSurface">#1C2023</item>
        <item name="colorOnSurface">#F1F3F1</item>
        <item name="android:statusBarColor">#15181A</item>
        <item name="android:navigationBarColor">#15181A</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColorPrimary">#F1F3F1</item>
        <item name="android:textColorSecondary">#9AA39C</item>
    </style>

    <!-- ───────────── Black (true AMOLED) ───────────── -->
    <style name="Theme.VCGEditor.Black" parent="Theme.VCGEditor.Base">
        <item name="isDarkTheme">true</item>
        <item name="colorBg">#000000</item>
        <item name="colorSurface2">#121212</item>
        <item name="colorCodeBg">#000000</item>
        <item name="colorBorder">#262626</item>
        <item name="colorAccentPrimary">#4DC95A</item>
        <item name="colorAccentSecondary">#5FE373</item>
        <item name="colorAccentLight">#102012</item>
        <item name="colorGold">#E8B23D</item>
        <item name="colorTextPrimary">#F5F5F5</item>
        <item name="colorTextMuted">#8C8C8C</item>
        <item name="colorErrorText">#FF6E6E</item>
        <item name="colorInfoText">#64A8FF</item>
        <item name="colorStatusBar">#000000</item>
        <item name="colorPrimary">#4DC95A</item>
        <item name="colorPrimaryVariant">#000000</item>
        <item name="colorSecondary">#5FE373</item>
        <item name="android:colorBackground">#000000</item>
        <item name="colorSurface">#000000</item>
        <item name="colorOnSurface">#F5F5F5</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColorPrimary">#F5F5F5</item>
        <item name="android:textColorSecondary">#8C8C8C</item>
    </style>

    <!-- ───────────── Blue (professional navy) ───────────── -->
    <style name="Theme.VCGEditor.Blue" parent="Theme.VCGEditor.Base">
        <item name="isDarkTheme">true</item>
        <item name="colorBg">#0E1A2B</item>
        <item name="colorSurface2">#1A2C46</item>
        <item name="colorCodeBg">#0F1E32</item>
        <item name="colorBorder">#2C4564</item>
        <item name="colorAccentPrimary">#3B82F6</item>
        <item name="colorAccentSecondary">#60A5FA</item>
        <item name="colorAccentLight">#1B2F4D</item>
        <item name="colorGold">#E0B33D</item>
        <item name="colorTextPrimary">#EAF1FB</item>
        <item name="colorTextMuted">#8FA8C7</item>
        <item name="colorErrorText">#FF7A7A</item>
        <item name="colorInfoText">#7FB8FF</item>
        <item name="colorStatusBar">#0E1A2B</item>
        <item name="colorPrimary">#3B82F6</item>
        <item name="colorPrimaryVariant">#0E1A2B</item>
        <item name="colorSecondary">#60A5FA</item>
        <item name="android:colorBackground">#0E1A2B</item>
        <item name="colorSurface">#132238</item>
        <item name="colorOnSurface">#EAF1FB</item>
        <item name="android:statusBarColor">#0E1A2B</item>
        <item name="android:navigationBarColor">#0E1A2B</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColorPrimary">#EAF1FB</item>
        <item name="android:textColorSecondary">#8FA8C7</item>
    </style>

    <!-- Back-compat alias: anything referencing the old single theme name now gets White -->
    <style name="Theme.VCGEditor" parent="Theme.VCGEditor.White"/>

    <!-- Toolbar: surface background, subtle divider, theme-aware title -->
    <style name="VCGToolbar" parent="Widget.MaterialComponents.Toolbar">
        <item name="android:background">?attr/colorSurface</item>
        <item name="titleTextColor">?attr/colorTextPrimary</item>
        <item name="subtitleTextColor">?attr/colorTextMuted</item>
        <item name="android:elevation">2dp</item>
    </style>

    <!-- Splash theme (no action bar) -->
    <style name="Theme.VCGEditor.Splash" parent="Theme.VCGEditor.White">
        <item name="android:windowFullscreen">false</item>
    </style>

    <!-- Custom dialog style -->
    <style name="VCGDialog" parent="Theme.MaterialComponents.DayNight.Dialog.Alert">
        <item name="colorPrimary">?attr/colorAccentPrimary</item>
        <item name="android:colorBackground">?attr/colorSurface</item>
        <item name="android:textColorPrimary">?attr/colorTextPrimary</item>
        <item name="android:textColorSecondary">?attr/colorTextMuted</item>
        <item name="buttonBarPositiveButtonStyle">@style/VCGButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/VCGButtonOutlined</item>
    </style>

    <style name="VCGButton" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">?attr/colorAccentPrimary</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="VCGButtonOutlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">?attr/colorBorder</item>
        <item name="strokeWidth">1.4dp</item>
        <item name="android:textColor">?attr/colorTextPrimary</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="rippleColor">?attr/colorAccentLight</item>
    </style>

    <!-- Flat secondary action button (e.g. insert asset / toggle preview) -->
    <style name="VCGButtonSubtle" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">?attr/colorSurface2</item>
        <item name="android:textColor">?attr/colorTextPrimary</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="elevation">0dp</item>
        <item name="rippleColor">?attr/colorAccentLight</item>
    </style>

    <!-- ═══ About / Help dialog typography ═══ -->
    <style name="AboutSectionTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">?attr/colorTextPrimary</item>
        <item name="android:textSize">15.5sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginBottom">10dp</item>
    </style>

    <style name="AboutBody">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">?attr/colorTextMuted</item>
        <item name="android:textSize">13.5sp</item>
        <item name="android:lineSpacingMultiplier">1.35</item>
        <item name="android:textAlignment">viewStart</item>
    </style>

    <style name="AboutFeatureRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">?attr/colorTextPrimary</item>
        <item name="android:textSize">13.5sp</item>
        <item name="android:paddingTop">7dp</item>
        <item name="android:paddingBottom">7dp</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
    </style>

    <style name="AboutDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">?attr/colorBorder</item>
        <item name="android:layout_marginTop">18dp</item>
    </style>

    <style name="AboutStepRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>

    <style name="AboutStepNumber">
        <item name="android:layout_width">26dp</item>
        <item name="android:layout_height">26dp</item>
        <item name="android:layout_marginStart">12dp</item>
        <item name="android:background">@drawable/bg_about_step_number</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="AboutStepTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">?attr/colorTextPrimary</item>
        <item name="android:textSize">13.5sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginBottom">2dp</item>
    </style>

    <style name="AboutStepBody">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">?attr/colorTextMuted</item>
        <item name="android:textSize">12.5sp</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
    </style>

    <!-- Animation for the custom editor popup menu (scale + fade from anchor) -->
    <style name="VCGPopupAnimation" parent="android:Animation">
        <item name="android:windowEnterAnimation">@anim/popup_enter</item>
        <item name="android:windowExitAnimation">@anim/popup_exit</item>
    </style>
</resources>

