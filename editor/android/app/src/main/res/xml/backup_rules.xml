<?xml version="1.0" encoding="utf-8"?>
<!--
    قواعد النسخ الاحتياطي (Android 11 وأقل — fullBackupContent).
    نستثني الكاش والملفات المؤقتة فقط؛ بيانات المشاريع في SharedPreferences
    مُدرجة افتراضياً ضمن النسخ الاحتياطي وهو السلوك المطلوب.
-->
<full-backup-content>
    <exclude domain="cache" path="."/>
    <exclude domain="external" path="."/>
</full-backup-content>
