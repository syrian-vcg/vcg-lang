<?xml version="1.0" encoding="utf-8"?>
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="140dp"
    android:targetCellWidth="3"
    android:targetCellHeight="3"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_editor"
    android:previewImage="@drawable/ic_vcg_logo"
    android:previewLayout="@layout/widget_editor"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_description"/>
<!--
    previewLayout (Android 12 / API 31+): يجعل منتقي الودجت يعرض تصميم
    الودجت الحقيقي (الترويسة + آخر مشروع + الأزرار) كمعاينة مباشرة، بدل
    أيقونة التطبيق فقط. على الأجهزة الأقدم من Android 12 يُستخدم previewImage
    تلقائياً كبديل، فلا حاجة لحذفه.
-->

