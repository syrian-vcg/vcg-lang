<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29"/>
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"/>
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO"/>
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.VCGEditor"
        android:hardwareAccelerated="true"
        android:enableOnBackInvokedCallback="true">

        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}"/>

        <activity
            android:name=".SplashActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.VCGEditor.Splash"/>

        <!--
            ════════════ Activity-alias لتبديل أيقونة التطبيق ════════════
            VcgIconSwitcher يفعّل واحداً من هذه الأربعة ويعطّل البقية حسب اختيار
            المستخدم في الإعدادات. كلها تشير لنفس SplashActivity كنقطة دخول،
            وتُفعَّل/تُعطَّل عبر PackageManager.setComponentEnabledSetting، لذا
            exported="true" + intent-filter LAUNCHER ضروريان لتظهر كأيقونة قابلة
            للتفعيل على الشاشة الرئيسية متى احتاجها التبديل.

            ملاحظة مهمة: SplashActivity الأساسية أعلاه لا تحمل intent-filter
            LAUNCHER خاص بها — هذا كان سبب ظهور نسختين من التطبيق على الشاشة
            الرئيسية (نسخة من <activity> نفسها + نسخة من LauncherOlive، وكلاهما
            مفعّل دائماً). الآن LauncherOlive وحده هو نقطة الدخول الافتراضية.
        -->
        <activity-alias
            android:name=".LauncherOlive"
            android:targetActivity=".SplashActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts"/>
        </activity-alias>

        <activity-alias
            android:name=".LauncherBlack"
            android:targetActivity=".SplashActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_black"
            android:roundIcon="@mipmap/ic_launcher_round_black"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherBlue"
            android:targetActivity=".SplashActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_blue"
            android:roundIcon="@mipmap/ic_launcher_round_blue"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherWhite"
            android:targetActivity=".SplashActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_white"
            android:roundIcon="@mipmap/ic_launcher_round_white"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".ProjectsActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="com.syrianvcg.editor.ACTION_NEW_PROJECT"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
            <intent-filter>
                <action android:name="com.syrianvcg.editor.ACTION_LAST_PROJECT"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"/>

        <activity
            android:name=".EditorActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"/>

        <activity
            android:name=".OutputActivity"
            android:exported="false"
            android:screenOrientation="portrait"/>

        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="com.syrianvcg.editor.ACTION_SETTINGS"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity>

        <activity
            android:name=".AssetsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"/>

        <activity
            android:name=".TerminalActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="com.syrianvcg.editor.ACTION_TERMINAL"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- ════════════ App Widget: تطبيق مصغّر للمحرر على الشاشة الرئيسية ════════════ -->
        <receiver
            android:name=".EditorWidgetProvider"
            android:icon="@mipmap/ic_launcher"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
                <action android:name="com.syrianvcg.editor.WIDGET_REFRESH"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_editor_info"/>
        </receiver>

    </application>
</manifest>
